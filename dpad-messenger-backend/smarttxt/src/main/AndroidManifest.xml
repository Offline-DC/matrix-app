<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SmartTxt runs over Apple's APNs + IDS, all of which need the network.
         The native rustpush path keeps a persistent APNs socket alive in
         APNsForegroundService. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service that hosts the (eventual) rustpush tokio runtime +
         APNs connection, so SmartTxts keep arriving with the UI closed. The
         data-sync type matches a persistent message-sync socket. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Briefly wakes the (cover) display when an incoming text arrives. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".APNsForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
