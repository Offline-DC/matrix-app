<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smart Txt runs over Apple's APNs + IDS, which need the network. The
         persistent APNs socket now lives in the launcher process itself
         (SmartTxtRepository.connectInBackground): the launcher is the
         android:persistent HOME app, so it stays connected WITHOUT a foreground
         service — and therefore without that service's mandatory, un-hideable
         status-bar notification (the old "smart txt connection" phantom icon).
         Mirrors the gmessages/signal backends, which also run in-process. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Posts incoming-message notifications; WAKE_LOCK briefly wakes the
         (cover) display when a text arrives. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- This module no longer runs a foreground service of its own. These are
         retained because the merged app still has data-sync foreground services
         (e.g. the launcher's diagnostics / reboot-logging services), which
         require these permissions at targetSdk 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package-visibility (Android 11+) for the launch-time OpenBubbles sweep,
         OpenBubblesMigrator.sweepOnLaunch. Without this, getPackageInfo() throws
         NameNotFoundException for OpenBubbles even when it IS installed, and the sweep
         silently concludes there is nothing to retire. Visibility only — it grants no
         access to OpenBubbles' data; the uninstall itself still goes through su. -->
    <queries>
        <package android:name="com.openbubbles.messaging" />
    </queries>
</manifest>
