# --- absinthe / nacserver secrets: NEVER commit these -----------------------
# The dumb file is a real Mac hardware identity; IMDAppleServices is Apple's
# binary. Both are supplied by the operator, kept off the repo. See
# ABSINTHE_REVERSE_ENGINEERING.md §0.
/dumb
*.dumb
IMDAppleServices
data.plist
# Rust + Python build artifacts for the new crates
absinthe/target/
__pycache__/
*.pyc

# smarttxt-ffi (rustpush JNI) build output. The .so is a build artifact produced
# by scripts/build-rustpush-so.sh / cargo-ndk — rebuild it per machine rather than
# committing it. (Remove the jniLibs line if you'd rather ship a prebuilt .so.)
smarttxt-ffi/target/
smarttxt/src/main/jniLibs/**/*.so
